rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read, write: if true;

      match /friends/{friendId} {
        allow read, write: if true;
      }

      match /active_duels/{opponentId} {
        allow read, write: if true;
      }
    }

    match /duel_challenges/{challengeId} {
      allow read, write: if true;
    }

    match /quiz_results/{resultId} {
      allow read, write: if true;
    }

    match /rankings/{rankingId} {
      allow read, write: if true;
    }

    match /test/{testId} {
      allow read, write: if true;
    }

    match /token_codes/{tokenId} {
      allow read: if true;
      allow delete: if true;
      allow create, update: if false;
    }

    match /shared_pill_codes/{codeId} {
      allow read: if true;
      allow create: if codeId.matches('^[0-9]{8}$')
        && request.resource.data.code == codeId
        && request.resource.data.keys().hasAll([
          'code','creatorUserId','reward','source','redeemed','createdAt'
        ])
        && request.resource.data.creatorUserId is string
        && request.resource.data.reward is int
        && request.resource.data.reward >= 1
        && request.resource.data.reward <= 99999
        && request.resource.data.source is string
        && request.resource.data.redeemed == false;
      allow update: if resource.data.redeemed == false
        && request.resource.data.redeemed == true
        && request.resource.data.reward == resource.data.reward
        && request.resource.data.code == resource.data.code
        && request.resource.data.creatorUserId == resource.data.creatorUserId
        && request.resource.data.source == resource.data.source
        && request.resource.data.redeemedBy is string
        && request.resource.data.keys().hasAll([
          'code','creatorUserId','reward','source','redeemed',
          'redeemedBy','redeemedAt','createdAt'
        ]);
      allow delete: if false;
    }

    match /olimpiadas/{editionId} {
      allow read: if true;
      match /inscritos/{userId} {
        allow read, write: if true;
      }
    }

    match /olimpiadas_config/{docId} {
      allow read: if true;
      allow write: if true;
    }

    match /olimpiadas_sesiones/{sessionId} {
      allow read: if true;
      match /jugadores/{jugadorId} {
        allow read, write: if true;
        match /examenes/{examId} {
          allow read, write: if true;
        }
      }
    }

    // ── Clínicos Doc (requiere Firebase Auth + claims role) ──
    function isSignedIn() {
      return request.auth != null;
    }
    function isMedico() {
      return isSignedIn() && request.auth.token.role == 'medico';
    }
    function isClinica() {
      return isSignedIn() && request.auth.token.role == 'clinica';
    }
    function isPaciente() {
      return isSignedIn() && request.auth.token.role == 'paciente';
    }
    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    function isClinicAdmin(clinicId) {
      return isSignedIn() && request.auth.uid == clinicId;
    }
    function isClinicMember(clinicId) {
      return isMedico()
        && exists(/databases/$(database)/documents/clinicosdoc_user/$(request.auth.uid)/clinic_memberships/$(clinicId));
    }

    match /clinicosdoc_user/{userId} {
      // create sin auth: registro app (luego auth-login). Lectura solo dueño/médico propio.
      allow create: if true;
      allow read, update, delete: if isOwner(userId);
      match /{document=**} {
        allow read, write: if isOwner(userId);
      }
    }

    match /clinicosdoc_patients/{patientKey} {
      allow read, write: if isMedico();
      match /documents/{docId} {
        allow read, write: if isMedico();
      }
    }

    match /pacientes/{cedula} {
      allow create: if true;
      allow read, update, delete: if isOwner(cedula) || isMedico();
      match /atenciones/{atencionId} {
        allow read, write: if isOwner(cedula) || isMedico();
      }
    }
    match /profesionales/{cedula} {
      allow create: if true;
      allow read, update, delete: if isMedico() || isOwner(cedula);
    }

    match /solicitudes/{solicitudId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn()
        && (resource.data.patientCedula == request.auth.token.cedula
            || isMedico());
    }

    match /fichas_emergencia/{fichaId} {
      allow read, write: if isSignedIn();
    }
    match /fichas_emergencia_cedula/{cedula} {
      allow read, write: if isSignedIn() && (isOwner(cedula) || isMedico() || isPaciente());
    }

    // ── Modo empresa / centro de salud ──
    match /clinicosdoc_clinics/{clinicId} {
      allow create: if true;
      allow read, update, delete: if isClinicAdmin(clinicId) || isClinicMember(clinicId);
      match /{document=**} {
        allow read, write: if isClinicAdmin(clinicId) || isClinicMember(clinicId);
      }
    }
    match /clinicosdoc_clinic_invites/{code} {
      allow read: if isSignedIn();
      allow write: if isClinica() || isMedico();
    }
    match /clinicosdoc_doctor_invites/{cedula} {
      allow read, write: if isSignedIn();
      match /{document=**} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
